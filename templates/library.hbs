<section class="tg-wrap tg-library-workspace">
  {{#if isGM}}
  <header class="tg-library-header">
    <div><h2>Библиотека таверн <span class="tg-count" aria-label="Всего таверн: {{total}}">{{total}}</span></h2><p class="tg-help">«Меню» открывает таверну у ГМа. Игроки входят кнопкой на её сцене.</p></div>
    <div class="tg-library-group-actions"><button type="button" data-library-action="collapseGroups" title="Свернуть группы на этой странице">Свернуть</button><button type="button" data-library-action="expandGroups" title="Развернуть группы">Развернуть</button></div>
  </header>
  <div class="tg-library-tools">
    <form class="tg-library-search" data-library-search>
      <input type="search" name="libraryQuery" value="{{filters.query}}" aria-label="Поиск по названию, городу, региону, местности или сцене" placeholder="Название, город, регион, сцена…" />
      <button type="submit">Найти</button><button type="button" data-library-action="reset" title="Сбросить поиск и фильтры">Сбросить</button>
    </form>
    <div class="tg-library-filters">
      <select data-library-filter="region" aria-label="Регион"><option value="">Все регионы</option>{{selectOptions regions selected=filters.region}}</select>
      <select data-library-filter="city" aria-label="Город"><option value="">Все города</option>{{#each cityChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <select data-library-filter="sort" aria-label="Порядок таверн внутри города"><option value="recent" {{#if (eq filters.sort "recent")}}selected{{/if}}>Сначала изменённые</option><option value="name" {{#if (eq filters.sort "name")}}selected{{/if}}>По названию</option></select>
    </div>
  </div>
  <div class="tg-library-list" data-library-scroll role="region" aria-label="Список сохранённых таверн" tabindex="0">
    {{#each regionGroups}}
    <details class="tg-library-region" data-library-group="{{key}}" {{#unless closed}}open{{/unless}}>
      <summary><span class="tg-library-group-title">{{label}}</span><span class="tg-library-group-count">{{total}}</span></summary>
      {{#each cities}}
      <details class="tg-library-city" data-library-group="{{key}}" {{#unless closed}}open{{/unless}}>
        <summary><span class="tg-library-group-title">{{name}}</span><span class="tg-library-group-count">{{total}}{{#if continued}} · продолжение{{/if}}</span></summary>
        <div class="tg-library-rows">
          {{#each rows}}
          <article class="tg-library-row {{#if active}}is-active{{/if}}">
            <div class="tg-library-description" title="Еда: {{foodCount}} · Напитки: {{drinkCount}} · Постой: {{roomCount}} · Услуги: {{serviceCount}}{{#if sceneName}} · Сцена: {{sceneName}}{{/if}}">
              <h3>{{name}}</h3><p>{{qualityLabel}} · {{terrainLabel}} · {{sizeLabel}}{{#if sceneName}} · {{sceneName}}{{/if}}</p>
            </div>
            <div class="tg-library-actions">
              <button type="button" data-library-action="edit" data-tavern-id="{{id}}" aria-label="Редактировать {{name}}">Изменить</button>
              <button type="button" data-library-action="preview" data-tavern-id="{{id}}" aria-label="Предпросмотр меню: {{name}}" title="Предпросмотр меню у ГМа">Меню</button>
              <button type="button" class="tg-library-delete" data-library-action="delete" data-tavern-id="{{id}}" aria-label="Удалить {{name}} из библиотеки">Удалить</button>
            </div>
          </article>
          {{/each}}
        </div>
      </details>
      {{/each}}
    </details>
    {{else}}
    <div class="tg-empty-state"><h3>{{#if emptyLibrary}}Здесь будут сохранённые таверны{{else}}Ничего не найдено{{/if}}</h3><p>{{#if emptyLibrary}}Создай таверну в генераторе и нажми «Сохранить в библиотеку».{{else}}Измени запрос или сбрось фильтры.{{/if}}</p></div>
    {{/each}}
  </div>
  <footer class="tg-library-pagination" aria-live="polite"><span>{{start}}–{{end}} из {{matched}}{{#if pending}} · Обработка…{{/if}}</span><div><button type="button" data-library-action="previous" {{#if previousDisabled}}disabled{{/if}} aria-label="Предыдущая страница">←</button><span>{{page}} / {{pages}}</span><button type="button" data-library-action="next" {{#if nextDisabled}}disabled{{/if}} aria-label="Следующая страница">→</button></div></footer>
  {{else}}<p>Менеджер таверн доступен только ГМу.</p>{{/if}}
</section>
