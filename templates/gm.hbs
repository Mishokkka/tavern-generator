<section class="tg-workspace">
{{#if isGM}}
  <header class="tg-workshop-header">
    <div><h1>Генератор таверн</h1></div>
    <div class="tg-header-actions">
      {{#if tavern}}<button type="button" data-step-target="setup"><i class="fa-solid fa-plus"></i> Новая таверна</button>{{/if}}
      <button type="button" data-action="openLibrary"><i class="fa-solid fa-book-open"></i> Библиотека <span class="tg-count">{{savedCount}}</span></button>
    </div>
  </header>
  <nav class="tg-workflow" role="tablist" aria-label="Создание и настройка таверны">
    <button type="button" role="tab" id="tg-step-setup" aria-controls="tg-panel-setup" data-workflow-step="setup" aria-selected="{{#if (eq workflowStep 'setup')}}true{{else}}false{{/if}}" tabindex="{{#if (eq workflowStep 'setup')}}0{{else}}-1{{/if}}" class="{{#if (eq workflowStep 'setup')}}is-active{{/if}}"><span class="tg-step-number">1</span><span>Параметры<small>Что сгенерировать</small></span></button>
    <button type="button" role="tab" id="tg-step-assortment" aria-controls="tg-panel-assortment" data-workflow-step="assortment" aria-selected="{{#if (eq workflowStep 'assortment')}}true{{else}}false{{/if}}" tabindex="{{#if (eq workflowStep 'assortment')}}0{{else}}-1{{/if}}" class="{{#if (eq workflowStep 'assortment')}}is-active{{/if}}" {{#unless tavern}}disabled{{/unless}}><span class="tg-step-number">2</span><span>Ассортимент<small>Название, меню и цены</small></span></button>
    <button type="button" role="tab" id="tg-step-extras" aria-controls="tg-panel-extras" data-workflow-step="extras" aria-selected="{{#if (eq workflowStep 'extras')}}true{{else}}false{{/if}}" tabindex="{{#if (eq workflowStep 'extras')}}0{{else}}-1{{/if}}" class="{{#if (eq workflowStep 'extras')}}is-active{{/if}}" {{#unless tavern}}disabled{{/unless}}><span class="tg-step-number">3</span><span>Сцена и тавернщик<small>По желанию</small></span></button>
    <button type="button" role="tab" id="tg-step-launch" aria-controls="tg-panel-launch" data-workflow-step="launch" aria-selected="{{#if (eq workflowStep 'launch')}}true{{else}}false{{/if}}" tabindex="{{#if (eq workflowStep 'launch')}}0{{else}}-1{{/if}}" class="{{#if (eq workflowStep 'launch')}}is-active{{/if}}" {{#unless tavern}}disabled{{/unless}}><span class="tg-step-number">4</span><span>Сохранение и запуск<small>В библиотеку и в игру</small></span></button>
  </nav>
  {{#if tavern}}
  <aside class="tg-draft-status" aria-label="Редактируемая таверна">
    <div><strong>{{tavern.name}}</strong><span>{{tavern.labels.region}}{{#if tavern.city}} · {{tavern.city}}{{/if}} · {{tavern.labels.quality}} · {{tavern.labels.size}} · {{tavern.labels.terrain}}</span></div>
    <div class="tg-draft-status-end"><span class="tg-status-badge">{{#if isSaved}}В библиотеке{{else}}Не сохранена{{/if}}</span><button type="button" data-action="undo" {{#unless canUndo}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Отменить правку</button></div>
    <p class="tg-help">{{#if autoSave}}Автосохранение · открытые меню этой таверны обновляются вместе с правками.{{else}}Черновик не сохранён. Сохранение и запуск — в последнем разделе.{{/if}}</p>
  </aside>
  {{/if}}
  <div class="tg-workflow-scroll" data-workflow-scroll>
    <section id="tg-panel-setup" class="tg-workflow-panel" data-workflow-panel="setup" role="tabpanel" aria-labelledby="tg-step-setup" {{#unless (eq workflowStep 'setup')}}hidden{{/unless}}>
      <div class="tg-step-heading"><h2 tabindex="-1">Какую таверну создать?</h2><p>Выбери характер заведения. Меню, ночлег, услуги и запасы появятся автоматически.</p></div>
      {{#if tavern}}<div class="tg-notice"><i class="fa-solid fa-circle-info"></i><span>Здесь задаются параметры <strong>другой таверны</strong>. Чтобы изменить меню открытого заведения, вернись в «Ассортимент».</span><button type="button" data-step-target="assortment">Вернуться к таверне</button></div>{{/if}}
      <div class="tg-setup-layout">
        <div class="tg-setup-fields">
          <label class="tg-field"><span>Название новой таверны</span><input type="text" name="generationName" data-param="name" value="{{params.name}}" maxlength="120" placeholder="Пусто — случайное название" aria-describedby="tg-help-name" /><small id="tg-help-name">Можно изменить после создания.</small></label>
          <label class="tg-field"><span>Город — по желанию</span><input type="text" name="generationCity" data-param="city" value="{{params.city}}" maxlength="120" placeholder="Любое название города" aria-describedby="tg-help-city" /><small id="tg-help-city">Одинаковые города объединяются в библиотеке внутри региона.</small></label>
          <label class="tg-field"><span>Регион</span><select name="region" data-param="region" aria-describedby="tg-help-region">{{selectOptions options.regions selected=params.region}}</select><small id="tg-help-region">Местная кухня, напитки, названия, услуги и культура тавернщика.</small></label>
          <label class="tg-field"><span>Местность</span><select name="terrain" data-param="terrain" aria-describedby="tg-help-terrain">{{selectOptions options.terrains selected=params.terrain}}</select><small id="tg-help-terrain">Доступные позиции, цены и начальная занятость ночлега.</small></label>
          <label class="tg-field"><span>Уровень заведения</span><select name="quality" data-param="quality" aria-describedby="tg-help-quality">{{selectOptions options.qualities selected=params.quality}}</select><small id="tg-help-quality">Цены, предпочтение простых или дорогих позиций, разнообразие и запасы.</small></label>
          <label class="tg-field"><span>Размер заведения</span><select name="size" data-param="size" aria-describedby="tg-help-size">{{selectOptions options.sizes selected=params.size}}</select><small id="tg-help-size">Разнообразие, места и порции. Размер не повышает цены.</small></label>
          <label class="tg-field tg-field-wide"><span>Дополнительный множитель цен, %</span><div class="tg-percent-input"><input type="number" name="priceMultiplierPercent" data-param="priceMultiplierPercent" min="10" max="500" step="5" value="{{priceMultiplierPercent}}" aria-describedby="tg-help-markup" /><span>%</span></div><small id="tg-help-markup" data-generation-preview="markup">{{generationPlan.markup}}</small></label>
        </div>
        <aside class="tg-generation-plan" aria-label="Результат генерации">
          <i class="fa-solid fa-wand-magic-sparkles"></i><h3>Что получится</h3>
          <ul><li data-generation-preview="menu">{{generationPlan.menu}}</li><li data-generation-preview="lodging">{{generationPlan.lodging}}</li><li data-generation-preview="services">{{generationPlan.services}}</li></ul>
          <p class="tg-help">Точное число зависит от доступных позиций каталога.</p>
          <div class="tg-plan-prices"><strong>Как складывается цена</strong><p data-generation-preview="prices">{{generationPlan.prices}}</p><small>Дополнительно учитываются регион и сезон, если включены сезонные цены.</small></div>
          <p class="tg-help" data-generation-preview="stock">{{generationPlan.stock}}</p>
        </aside>
      </div>
      <div class="tg-generation-submit"><p>На следующем шаге можно изменить название и любую позицию меню.</p><button type="button" class="tg-primary" data-action="generate"><i class="fa-solid fa-dice"></i> {{#if tavern}}Сгенерировать другую таверну{{else}}Сгенерировать таверну{{/if}} <i class="fa-solid fa-arrow-right"></i></button></div>
    </section>
    {{#if tavern}}
    <section id="tg-panel-assortment" class="tg-workflow-panel" data-workflow-panel="assortment" role="tabpanel" aria-labelledby="tg-step-assortment" {{#unless (eq workflowStep 'assortment')}}hidden{{/unless}}>
      <div class="tg-step-heading"><h2 tabindex="-1">Название и ассортимент</h2><p>Измени нужные позиции, цены и остатки или перейди к сохранению.</p></div>
      <div class="tg-editor-basics">
        <div class="tg-name-editor"><label class="tg-field"><span>Название таверны</span><input type="text" name="tavernName" value="{{tavern.name}}" maxlength="120" /></label><div class="tg-inline-actions"><button type="button" data-action="rename">Применить название</button><button type="button" data-action="rerollName"><i class="fa-solid fa-dice"></i> Случайное</button></div></div>
        <div class="tg-name-editor"><label class="tg-field"><span>Город</span><input type="text" name="tavernCity" value="{{tavern.city}}" maxlength="120" placeholder="Без города" /></label><button type="button" data-action="setCity">Применить город</button><p class="tg-help">Группировка в библиотеке внутри региона. Пустое поле убирает город.</p></div>
        <div class="tg-price-editor"><label class="tg-field"><span>Множитель цен этой таверны, %</span><input type="number" name="draftPricePercent" min="10" max="500" step="5" value="{{tavern.priceMultiplierPercent}}" /></label><button type="button" data-action="applyPriceModifier">Применить к меню</button><p class="tg-help">100% — без наценки; 150% — базовые цены ×1,5. Пересчёт не накапливается.</p></div>
      </div>
      <details class="tg-offering-status" {{#if offeringExpanded}}open{{/if}}><summary>{{#if offeringStatus.complete}}Основа обеспечена{{else}}Есть пробелы в основе{{/if}}</summary><p class="tg-help">{{offeringStatus.summary}}</p><p class="tg-help">Проверка учитывает назначение позиций. Распроданное предложение остаётся частью таверны; запасы пополняются отдельно.</p><button type="button" data-action="ensureOfferings" {{#if offeringStatus.complete}}disabled{{/if}}>Добавить недостающее</button></details>
      <nav class="tg-editor-tabs" role="tablist" aria-label="Разделы ассортимента">
        <button type="button" data-editor-tab="menu" role="tab" id="tg-editor-tab-menu" aria-controls="tg-editor-panel-menu" tabindex="{{#if (eq editorTab 'menu')}}0{{else}}-1{{/if}}" class="{{#if (eq editorTab 'menu')}}is-active{{/if}}" aria-selected="{{#if (eq editorTab 'menu')}}true{{else}}false{{/if}}">Еда <span class="tg-count">{{tavern.food.length}}</span> и напитки <span class="tg-count">{{tavern.drinks.length}}</span></button>
        <button type="button" data-editor-tab="stay" role="tab" id="tg-editor-tab-stay" aria-controls="tg-editor-panel-stay" tabindex="{{#if (eq editorTab 'stay')}}0{{else}}-1{{/if}}" class="{{#if (eq editorTab 'stay')}}is-active{{/if}}" aria-selected="{{#if (eq editorTab 'stay')}}true{{else}}false{{/if}}">Ночлег <span class="tg-count">{{tavern.lodging.length}}</span> и услуги <span class="tg-count">{{tavern.services.length}}</span></button>
      </nav>
      <p class="tg-help tg-entry-legend"><i class="fa-solid fa-thumbtack"></i> Закрепить позицию на следующие дни · <i class="fa-solid fa-pen-to-square"></i> Изменить · <i class="fa-solid fa-xmark"></i> Удалить. Описание позиции — при наведении.</p>
    <section class="tg-tab-panel tg-menu-stack" data-editor-panel="menu" role="tabpanel" id="tg-editor-panel-menu" aria-labelledby="tg-editor-tab-menu" {{#unless (eq editorTab "menu")}}hidden{{/unless}}>
      <div class="tg-panel tg-panel-full">
        <div class="tg-panel-head">
          <h3>Еда</h3>
          <div class="tg-panel-head-actions">
            <button type="button" data-action="addCustom" data-category="food" data-tooltip="Добавить свою позицию"><i class="fa-solid fa-plus"></i> Своя позиция</button>
            <button type="button" data-action="addRandom" data-category="food" data-tooltip="Добавить случайную позицию"><i class="fa-solid fa-dice"></i> Случайная</button>
          </div>
        </div>
        <div class="tg-list tg-card-grid">
          {{#each tavern.food}}
            <article class="tg-row tg-shop-row" data-tooltip="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>{{#if local}}местное · {{/if}}осталось: {{stockLabel}}</small>
              </div>
              <div class="tg-gm-entry-actions">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                </div>
                <button type="button" class="{{#if pinned}}is-pinned{{/if}}" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}" aria-label="{{#if pinned}}Открепить{{else}}Закрепить{{/if}} {{name}}" data-action="togglePinned" data-category="food" data-entry-id="{{id}}" data-tooltip="{{#if pinned}}Открепить от дневной ротации{{else}}Закрепить от дневной ротации{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>
                <button type="button" data-action="editEntry" data-category="food" data-entry-id="{{id}}" aria-label="Редактировать {{name}}" data-tooltip="Редактировать"><i class="fa-solid fa-pen-to-square"></i></button>
                <button type="button" data-action="removeEntry" data-category="food" data-entry-id="{{id}}" aria-label="Убрать {{name}}" data-tooltip="Убрать"><i class="fa-solid fa-xmark"></i></button>
              </div>
            </article>
          {{else}}
            <p class="tg-help">Пока пусто. Добавь свою или случайную позицию.</p>
          {{/each}}
        </div>
      </div>

      <div class="tg-panel tg-panel-full">
        <div class="tg-panel-head">
          <h3>Напитки</h3>
          <div class="tg-panel-head-actions">
            <button type="button" data-action="addCustom" data-category="drinks" data-tooltip="Добавить свою позицию"><i class="fa-solid fa-plus"></i> Своя позиция</button>
            <button type="button" data-action="addRandom" data-category="drinks" data-tooltip="Добавить случайную позицию"><i class="fa-solid fa-dice"></i> Случайная</button>
          </div>
        </div>
        <div class="tg-list tg-card-grid">
          {{#each tavern.drinks}}
            <article class="tg-row tg-shop-row" data-tooltip="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>{{#if local}}местное · {{/if}}осталось: {{stockLabel}}</small>
              </div>
              <div class="tg-gm-entry-actions">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                </div>
                <button type="button" class="{{#if pinned}}is-pinned{{/if}}" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}" aria-label="{{#if pinned}}Открепить{{else}}Закрепить{{/if}} {{name}}" data-action="togglePinned" data-category="drinks" data-entry-id="{{id}}" data-tooltip="{{#if pinned}}Открепить от дневной ротации{{else}}Закрепить от дневной ротации{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>
                <button type="button" data-action="editEntry" data-category="drinks" data-entry-id="{{id}}" aria-label="Редактировать {{name}}" data-tooltip="Редактировать"><i class="fa-solid fa-pen-to-square"></i></button>
                <button type="button" data-action="removeEntry" data-category="drinks" data-entry-id="{{id}}" aria-label="Убрать {{name}}" data-tooltip="Убрать"><i class="fa-solid fa-xmark"></i></button>
              </div>
            </article>
          {{else}}
            <p class="tg-help">Пока пусто. Добавь свою или случайную позицию.</p>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="tg-tab-panel tg-grid tg-grid-2" data-editor-panel="stay" role="tabpanel" id="tg-editor-panel-stay" aria-labelledby="tg-editor-tab-stay" {{#unless (eq editorTab "stay")}}hidden{{/unless}}>
      <div class="tg-panel">
        <div class="tg-panel-head">
          <h3>Ночлег</h3>
          <div class="tg-panel-head-actions">
            <button type="button" data-action="addCustom" data-category="lodging" data-tooltip="Добавить свою позицию"><i class="fa-solid fa-plus"></i> Своя позиция</button>
            <button type="button" data-action="addRandom" data-category="lodging" data-tooltip="Добавить случайную позицию"><i class="fa-solid fa-dice"></i> Случайная</button>
          </div>
        </div>
        <div class="tg-list tg-card-grid tg-lodging-grid">
          {{#each tavern.lodging}}
            <article class="tg-row tg-row-edit" data-tooltip="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>свободно: {{freeLabel}}</small>
                <div class="tg-lodging-edit">
                  <label><span>Свободно</span><input type="number" data-lodging-field="stock" data-entry-id="{{id}}" min="0" max="{{total}}" value="{{free}}" {{#if unlimited}}disabled{{/if}} /></label>
                  <label><span>Всего</span><input type="number" data-lodging-field="total" data-entry-id="{{id}}" min="0" max="999" value="{{total}}" {{#if unlimited}}disabled{{/if}} /></label>
                  <label class="tg-check"><input type="checkbox" data-lodging-field="unlimited" data-entry-id="{{id}}" {{#if unlimited}}checked{{/if}} /> без ограничения</label>
                </div>
              </div>
              <div class="tg-gm-entry-actions">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                </div>
                <button type="button" class="{{#if pinned}}is-pinned{{/if}}" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}" aria-label="{{#if pinned}}Открепить{{else}}Закрепить{{/if}} {{name}}" data-action="togglePinned" data-category="lodging" data-entry-id="{{id}}" data-tooltip="{{#if pinned}}Открепить от дневной ротации{{else}}Закрепить от дневной ротации{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>
                <button type="button" data-action="editEntry" data-category="lodging" data-entry-id="{{id}}" aria-label="Редактировать {{name}}" data-tooltip="Редактировать"><i class="fa-solid fa-pen-to-square"></i></button>
                <button type="button" data-action="removeEntry" data-category="lodging" data-entry-id="{{id}}" aria-label="Убрать {{name}}" data-tooltip="Убрать"><i class="fa-solid fa-xmark"></i></button>
              </div>
            </article>
          {{else}}
            <p class="tg-help">Пока пусто. Добавь свою или случайную позицию.</p>
          {{/each}}
        </div>
      </div>

      <div class="tg-panel">
        <div class="tg-panel-head">
          <h3>Услуги</h3><button type="button" data-action="addProvisions">Добавить пайки и воду</button>
          <div class="tg-panel-head-actions">
            <button type="button" data-action="addCustom" data-category="services" data-tooltip="Добавить свою позицию"><i class="fa-solid fa-plus"></i> Своя позиция</button>
            <button type="button" data-action="addRandom" data-category="services" data-tooltip="Добавить случайную позицию"><i class="fa-solid fa-dice"></i> Случайная</button>
          </div>
        </div>
        <div class="tg-list tg-card-grid">
          {{#each tavern.services}}
            <article class="tg-row tg-shop-row" data-tooltip="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>{{#if resource}}шагов в продаже{{else}}доступно сегодня{{/if}}: {{stockLabel}}{{#if cleanliness}} · {{cleanliness.label}}{{/if}}</small>
              </div>
              <div class="tg-gm-entry-actions">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                </div>
                <button type="button" class="{{#if pinned}}is-pinned{{/if}}" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}" aria-label="{{#if pinned}}Открепить{{else}}Закрепить{{/if}} {{name}}" data-action="togglePinned" data-category="services" data-entry-id="{{id}}" data-tooltip="{{#if pinned}}Открепить от дневной ротации{{else}}Закрепить от дневной ротации{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>
                <button type="button" data-action="editEntry" data-category="services" data-entry-id="{{id}}" aria-label="Редактировать {{name}}" data-tooltip="Редактировать"><i class="fa-solid fa-pen-to-square"></i></button>
                <button type="button" data-action="removeEntry" data-category="services" data-entry-id="{{id}}" aria-label="Убрать {{name}}" data-tooltip="Убрать"><i class="fa-solid fa-xmark"></i></button>
              </div>
            </article>
          {{else}}
            <p class="tg-help">Пока пусто. Добавь свою или случайную позицию.</p>
          {{/each}}
        </div>
      </div>
    </section>


      <details class="tg-stock-tools"><summary>Управление запасами</summary><div class="tg-stock-actions"><div><strong>Пополнить остатки</strong><p class="tg-help">Вернуть еду, напитки и услуги к их максимальным запасам. Занятый ночлег не освобождается.</p><button type="button" data-action="restockAll"><i class="fa-solid fa-boxes-stacked"></i> Пополнить запасы</button></div><div><strong>Пересчитать нормы</strong><p class="tg-help">Заново рассчитать и пополнить каталожные запасы по размеру таверны. Свои позиции и ночлег сохраняются.</p><button type="button" data-action="renewStockNorms">Пересчитать и пополнить</button></div></div></details>
    </section>
    <section id="tg-panel-extras" class="tg-workflow-panel" data-workflow-panel="extras" role="tabpanel" aria-labelledby="tg-step-extras" {{#unless (eq workflowStep 'extras')}}hidden{{/unless}}>
      <div class="tg-step-heading"><h2 tabindex="-1">Добавь сцену и тавернщика</h2><p>Необязательно. Меню работает и без них — можно сразу перейти к сохранению и запуску.</p></div>
      <p class="tg-notice">Сцену и тавернщика можно создавать в любом порядке. Создание также сохраняет таверну в библиотеку.</p>
      <section class="tg-extra-card">
        <div class="tg-panel-head"><h3><i class="fa-solid fa-user-tie"></i> Тавернщик</h3><span class="tg-status-badge">{{#if tavernkeeper}}Связан с таверной{{else}}Не создан{{/if}}</span></div>
        {{#if tavernkeeper}}<div class="tg-keeper-preview"><img src="{{tavernkeeper.currentImg}}" alt="Портрет {{tavernkeeper.currentName}}" /><div><strong>{{tavernkeeper.currentName}}</strong><p class="tg-help">{{#if tavernkeeper.exists}}Актёр в мире{{else}}{{#if tavernkeeper.archived}}Можно восстановить из компендиума{{else}}Актёр удалён{{/if}}{{/if}}</p></div>{{#if tavernkeeper.tokenImg}}<img class="tg-keeper-token" src="{{tavernkeeper.tokenImg}}" alt="Токен {{tavernkeeper.currentName}}" />{{/if}}</div>{{else}}<p class="tg-help">Случайный персонаж с именем, портретом и токеном через Character Forge. Набор имён: <strong>{{characterForge.nameSetLabel}}</strong>.</p>{{/if}}
        {{#unless characterForge.available}}<p class="tg-notice">Создание недоступно: {{characterForge.availabilityLabel}}. Остальные возможности генератора доступны.</p>{{/unless}}
        <div class="tg-extra-options">
          <label class="tg-check"><input type="checkbox" name="keeperArchiveToCompendium" data-keeper-param="archiveToCompendium" {{#if keeperConfig.archiveToCompendium}}checked{{/if}} /> Сохранить копию актёра в компендиуме</label>
          <label class="tg-check"><input type="checkbox" name="keeperPlaceTokenOnScene" data-keeper-param="placeTokenOnScene" {{#if keeperConfig.placeTokenOnScene}}checked{{/if}} /> Добавлять токен при создании тавернщика или сцены</label>
        </div>
        <div class="tg-inline-actions">
          <button type="button" data-action="createTavernkeeper" {{#unless characterForge.available}}disabled{{/unless}}><i class="fa-solid fa-user-plus"></i> {{#if tavernkeeper}}Заменить тавернщика{{else}}Создать тавернщика{{/if}}</button>
          {{#if tavernkeeper}}<button type="button" data-action="openTavernkeeper" {{#unless tavernkeeper.exists}}{{#unless tavernkeeper.archived}}disabled{{/unless}}{{/unless}}>Открыть лист</button>{{/if}}
          <button type="button" data-action="placeTavernkeeper" {{#unless canPlaceKeeper}}disabled{{/unless}}><i class="fa-solid fa-street-view"></i> Добавить / обновить токен на сцене</button>
        </div>
        {{#unless hasLinkedSceneMeta}}<p class="tg-help">Токен можно поставить после создания сцены ниже. Если автоматическое добавление включено, он появится сам.</p>{{/unless}}
      </section>
      <section class="tg-extra-card">
        <div class="tg-panel-head"><h3><i class="fa-solid fa-image"></i> Сцена таверны</h3><span class="tg-status-badge">{{#if linkedScene}}{{linkedScene.name}}{{else}}Не создана{{/if}}</span></div>
        <p class="tg-help">Отдельная сцена с фоном и кнопкой меню таверны. Случайный фон подбирается по региону и уровню заведения.</p>
        <div class="tg-scene-fields">
          <label class="tg-field"><span>Источник фона</span><select name="sceneMode" data-scene-param="mode">{{selectOptions sceneOptions.modes selected=sceneConfig.mode}}</select></label>
          {{#if hasSceneTemplateChoices}}<label class="tg-field"><span>Шаблон сцены</span><select name="sceneTemplateId" data-scene-param="templateId">{{selectOptions sceneOptions.templates selected=sceneConfig.templateId}}</select></label>{{/if}}
          {{#if manualScene}}<label class="tg-field tg-field-wide"><span>Файл фона</span><div class="tg-path-picker"><input type="text" name="sceneManualImagePath" data-scene-param="manualImagePath" value="{{sceneConfig.manualImagePath}}" placeholder="Путь к изображению" /><button type="button" data-action="browseSceneImage"><i class="fa-solid fa-folder-open"></i> Выбрать файл</button></div></label>{{/if}}
        </div>
        <details class="tg-scene-options"><summary>После создания сцены</summary><div class="tg-extra-options">
          <label class="tg-check"><input type="checkbox" data-scene-param="openAfterCreate" {{#if sceneConfig.openAfterCreate}}checked{{/if}} /> Открыть сцену у меня</label>
          <label class="tg-check"><input type="checkbox" data-scene-param="activateScene" {{#if sceneConfig.activateScene}}checked{{/if}} /> Сделать сцену активной</label>
          <label class="tg-check"><input type="checkbox" data-scene-param="showPlayers" {{#if sceneConfig.showPlayers}}checked{{/if}} /> Активировать и перевести всех игроков</label>
          <label class="tg-check"><input type="checkbox" data-scene-param="archiveToCompendium" {{#if sceneConfig.archiveToCompendium}}checked{{/if}} /> Сохранить копию сцены в компендиуме</label>
          <label class="tg-check"><input type="checkbox" data-scene-param="createShopNote" {{#if sceneConfig.createShopNote}}checked{{/if}} /> Добавить на сцену кнопку меню таверны</label>
        </div></details>
        <p class="tg-help" data-scene-hint>{{sceneDisabledReason}}</p>
        <div class="tg-inline-actions"><button type="button" data-action="createScene" {{#if sceneCreateDisabled}}disabled{{/if}}><i class="fa-solid fa-plus"></i> {{#if linkedScene}}Создать другую сцену{{else}}Создать сцену{{/if}}</button>{{#if linkedScene}}<button type="button" data-action="openLinkedScene"><i class="fa-solid fa-door-open"></i> Открыть связанную сцену</button>{{/if}}</div>
      </section>
    </section>
    <section id="tg-panel-launch" class="tg-workflow-panel" data-workflow-panel="launch" role="tabpanel" aria-labelledby="tg-step-launch" {{#unless (eq workflowStep 'launch')}}hidden{{/unless}}>
      <div class="tg-step-heading"><h2 tabindex="-1">Таверна готова к игре</h2><p>На связанной сцене игроки открывают меню её кнопкой. Можно также показать меню всем подключённым игрокам.</p></div>
      <section class="tg-launch-summary"><h3>{{tavern.name}}</h3><p>{{tavern.labels.region}}{{#if tavern.city}} · {{tavern.city}}{{/if}} · {{tavern.labels.quality}} · {{tavern.labels.size}} · {{tavern.labels.terrain}}</p><div class="tg-launch-counts"><span><strong>{{tavern.food.length}}</strong> блюд</span><span><strong>{{tavern.drinks.length}}</strong> напитков</span><span><strong>{{tavern.lodging.length}}</strong> вариантов ночлега</span><span><strong>{{tavern.services.length}}</strong> услуг</span></div><p class="tg-help">Множитель цен: {{tavern.priceMultiplierPercent}}% · Сцена: {{#if linkedScene}}{{linkedScene.name}}{{else}}без сцены{{/if}} · Тавернщик: {{#if tavernkeeper}}{{tavernkeeper.currentName}}{{else}}без персонажа{{/if}}</p></section>
      <div class="tg-launch-cards">
        <section class="tg-launch-card"><i class="fa-solid fa-floppy-disk"></i><h3>Оставить на потом</h3><p>Сохранить в библиотеку. Можно вернуться к редактированию в любое время.</p><button type="button" data-action="saveDraft" {{#if isSaved}}disabled{{/if}}>{{#if isSaved}}Уже в библиотеке{{else}}Сохранить в библиотеку{{/if}}</button></section>
        <section class="tg-launch-card"><i class="fa-solid fa-eye"></i><h3>Проверить меню</h3><p>Открыть окно этой таверны у себя и проверить, как выглядит ассортимент.</p><button type="button" data-action="openTavern">Предпросмотр меню</button></section>
        <section class="tg-launch-card tg-launch-primary"><i class="fa-solid fa-users"></i><h3>Показать всем игрокам</h3><p>Сохранить эту таверну и открыть её меню подключённым игрокам.</p><button type="button" class="tg-primary" data-action="openPlayers"><i class="fa-solid fa-users"></i> Сохранить и открыть игрокам</button></section>
      </div>
    </section>
    {{/if}}
  </div>
  <footer class="tg-workflow-footer" data-workflow-footer {{#if (eq workflowStep 'setup')}}hidden{{/if}}>
    <div class="tg-workflow-footer-nav"><button type="button" data-workflow-previous data-step-target="assortment" hidden>Назад</button><span class="tg-help">Дополнения можно пропустить.</span><button type="button" class="tg-primary" data-workflow-next data-step-target="extras">Далее →</button></div>
  </footer>
{{else}}<p>Генератор доступен только ГМу.</p>{{/if}}
</section>
