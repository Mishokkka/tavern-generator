<section class="tg-wrap">
  {{#if tavern}}
    {{#if isGM}}
      <div class="tg-tavern-navigation">
        <nav class="tg-tabs" role="tablist" aria-label="Разделы таверны">
          <button type="button" id="tg-player-tab-menu" class="tg-tab-button {{#if tabs.menu.active}}is-active{{/if}}" data-action="select-tab" data-tab="menu" role="tab" aria-controls="tg-player-panel-menu" aria-selected="{{tabs.menu.active}}" tabindex="{{#if tabs.menu.active}}0{{else}}-1{{/if}}"><i class="fa-solid fa-utensils"></i><span>Меню</span></button>
          <button type="button" id="tg-player-tab-life" class="tg-tab-button {{#if tabs.life.active}}is-active{{/if}}" data-action="select-tab" data-tab="life" role="tab" aria-controls="tg-player-panel-life" aria-selected="{{tabs.life.active}}" tabindex="{{#if tabs.life.active}}0{{else}}-1{{/if}}"><i class="fa-solid fa-user-shield"></i><span>Жизнь таверны</span></button>
        </nav>
        <button type="button" class="tg-new-day" data-gm-action="newDay" {{#if gmActionPending}}disabled{{else}}{{#unless lifeTavern}}disabled{{/unless}}{{/if}} data-tooltip="Начать новый день только в этой таверне" aria-label="Начать новый день только в этой таверне"><i class="fa-solid {{#if gmActionPending}}fa-spinner fa-spin{{else}}fa-sun{{/if}}"></i><span>Новый день</span></button>
      </div>
    {{/if}}
    <div id="tg-player-panel-menu" class="tg-tab-panel" {{#if isGM}}role="tabpanel" aria-labelledby="tg-player-tab-menu"{{/if}} {{#unless tabs.menu.active}}hidden{{/unless}}>
    <section class="tg-player-toolbar" aria-label="Управление таверной">
      <div class="tg-payment-summary">
        {{#if showActorPicker}}
          <label class="tg-payer-field">
            <span class="tg-inline-label">Платит</span>
            <select data-action="select-actor" name="selectedActorId" {{#if cart.locked}}disabled{{/if}}>
              {{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select>
          </label>
        {{/if}}

        <div class="tg-wallet-summary">
          <span class="tg-inline-label">Кошелек</span>
          {{#if wallet.hasActor}}
            <span class="tg-money-list tg-money-list--wallet" aria-label="Кошелек персонажа">
              {{#each wallet.parts}}
                <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
              {{/each}}
            </span>
            <small class="tg-wallet-note {{#if wallet.isFallback}}is-warning{{/if}}">{{wallet.sourceLabel}}</small>
          {{else}}
            <small class="tg-wallet-note is-warning">Персонаж не привязан.</small>
          {{/if}}
        </div>
      </div>

      <div class="tg-player-actions">


        <button type="button" class="tg-header-action tg-search-toggle {{#if searchQuery}}has-query{{/if}}" data-action="toggle-search" data-tooltip="Поиск по меню" aria-label="Открыть или скрыть поиск по меню" aria-expanded="{{searchExpanded}}">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <span class="tg-search-indicator" aria-hidden="true"></span>
        </button>
      </div>

      <button type="button" class="tg-cart-button" data-action="open-cart" data-tooltip="Корзина" aria-label="Корзина">
        <i class="fa-solid {{#if cart.checkoutPending}}fa-spinner fa-spin{{else}}fa-basket-shopping{{/if}}"></i>
        <span class="tg-cart-count">{{cart.count}}</span>
        <span class="tg-cart-sum">{{{cart.totalLabel}}}</span>
      </button>

      <div class="tg-player-search-row {{#if searchExpanded}}is-open{{/if}} {{#if searchQuery}}has-query{{/if}}" aria-hidden="{{#if searchExpanded}}false{{else}}true{{/if}}">
        <div class="tg-search-field">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" data-action="menu-search" value="{{searchQuery}}" placeholder="Поиск по меню и описанию" aria-label="Поиск по меню и описанию" autocomplete="off">
          <button type="button" class="tg-search-clear" data-action="clear-search" data-tooltip="Очистить поиск" aria-label="Очистить поиск"><i class="fa-solid fa-xmark"></i></button>
        </div>
      </div>
    </section>


    <section class="tg-menu-stack">
      <div class="tg-panel tg-panel-full">
        <h3>Еда</h3>
        <div class="tg-list tg-card-grid">
          {{#each tavern.food}}
            <article class="tg-row tg-shop-row" data-category="food" data-entry-id="{{id}}" data-unit-price="{{price}}" data-tooltip="{{desc}}" data-search-text="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>{{#if local}}местное · {{/if}}осталось: {{stockLabel}}{{#if seasonalChanged}} · сезонная цена{{/if}}</small>
              </div>
              <div class="tg-buy-block">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                </div>
                <button type="button" class="tg-add-cart" data-action="add-cart" data-category="food" data-entry-id="{{id}}" data-tooltip="Добавить в корзину" aria-label="Добавить в корзину" {{#if ../cart.locked}}disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}>
                  <i class="fa-solid fa-basket-shopping"></i>
                </button>
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      <div class="tg-panel tg-panel-full">
        <h3>Напитки</h3>
        <div class="tg-list tg-card-grid">
          {{#each tavern.drinks}}
            <article class="tg-row tg-shop-row" data-category="drinks" data-entry-id="{{id}}" data-unit-price="{{price}}" data-tooltip="{{desc}}" data-search-text="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>{{#if local}}местное · {{/if}}осталось: {{stockLabel}}{{#if seasonalChanged}} · сезонная цена{{/if}}</small>
              </div>
              <div class="tg-buy-block">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                </div>
                <button type="button" class="tg-add-cart" data-action="add-cart" data-category="drinks" data-entry-id="{{id}}" data-tooltip="Добавить в корзину" aria-label="Добавить в корзину" {{#if ../cart.locked}}disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}>
                  <i class="fa-solid fa-basket-shopping"></i>
                </button>
              </div>
            </article>
          {{/each}}
        </div>
      </div>
    </section>

    <section class="tg-grid tg-grid-2">
      <div class="tg-panel">
        <h3>Ночлег</h3>
        <div class="tg-list tg-card-grid">
          {{#each tavern.lodging}}
            <article class="tg-row tg-shop-row" data-category="lodging" data-entry-id="{{id}}" data-unit-price="{{price}}" data-tooltip="{{desc}}" data-search-text="{{desc}}" data-tooltip-direction="UP">
              <div class="tg-entry-main">
                <strong class="tg-entry-name">{{name}}</strong>
                <small>свободно: {{freeLabel}}{{#if seasonalChanged}} · сезонная цена{{/if}}</small>
              </div>
              <div class="tg-buy-block">
                <div class="tg-price">
                  {{#each priceParts}}
                    <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                  {{/each}}
                  <small>за место/день</small>
                </div>
                <button type="button" class="tg-add-cart" data-action="add-cart" data-category="lodging" data-entry-id="{{id}}" data-tooltip="Добавить в корзину" aria-label="Добавить в корзину" {{#if ../cart.locked}}disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}>
                  <i class="fa-solid fa-basket-shopping"></i>
                </button>
              </div>
            </article>
          {{/each}}
        </div>
      </div>

      {{#if tavern.services.length}}
        <div class="tg-panel">
          <h3>Услуги</h3>
          <div class="tg-list tg-card-grid">
            {{#each tavern.services}}
              <article class="tg-row tg-shop-row" data-category="services" data-entry-id="{{id}}" data-unit-price="{{price}}" data-tooltip="{{desc}}" data-search-text="{{desc}}" data-tooltip-direction="UP">
                <div class="tg-entry-main">
                  <strong class="tg-entry-name">{{name}}</strong>
                  <small>осталось: {{stockLabel}}{{#if cleanliness}} · {{cleanliness.label}}{{/if}}{{#if seasonalChanged}} · сезонная цена{{/if}}</small>
                </div>
                <div class="tg-buy-block">
                  <div class="tg-price">
                    {{#each priceParts}}
                      <span class="tg-money"><span class="tg-money__amount">{{amount}}</span><span class="tg-coin tg-coin--{{code}}">{{label}}</span></span>
                    {{/each}}
                  </div>
                  <button type="button" class="tg-add-cart" data-action="add-cart" data-category="services" data-entry-id="{{id}}" data-tooltip="Добавить в корзину" aria-label="Добавить в корзину" {{#if ../cart.locked}}disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}>
                    <i class="fa-solid fa-basket-shopping"></i>
                  </button>
                </div>
              </article>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </section>
    </div>
    {{#if isGM}}
      <div id="tg-player-panel-life" class="tg-tab-panel" role="tabpanel" aria-labelledby="tg-player-tab-life" {{#unless tabs.life.active}}hidden{{/unless}}>
        {{#if lifeTavern}}
    <section class="tg-life-dashboard">
      <div class="tg-gm-only-note"><i class="fa-solid fa-user-shield"></i><span>Эта вкладка доступна только ГМу. Игроки увидят запись лишь после ручной отправки в чат.</span></div>

      <div class="tg-panel tg-panel-full tg-life-overview">
        <div class="tg-panel-head">
          <div>
            <h3>Жизнь таверны</h3>
            <p><strong>{{lifeTavern.atmosphere.mood.label}}</strong> · {{lifeTavern.atmosphere.crowdLabel}} ({{lifeTavern.atmosphere.crowd}}%)</p>
          </div>
          <div class="tg-panel-head-actions">
            <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} class="tg-apply-crowd" data-gm-action="applyCrowdAvailability" data-tooltip="Сохранить текущую заполненность, обновить связанную сцену и доступность у игроков" aria-label="Сохранить текущую заполненность, обновить связанную сцену и доступность у игроков"><i class="fa-solid fa-check"></i><span>Применить заполненность</span></button>
            <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="rerollMood" data-section="mood" data-tooltip="Обновить только обстановку" aria-label="Обновить только обстановку"><i class="fa-solid fa-cloud-sun"></i></button>
            <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="regenerateAtmosphere" data-tooltip="Полностью пересобрать слухи, посетителей и происшествие" aria-label="Полностью пересобрать слухи, посетителей и происшествие"><i class="fa-solid fa-arrows-rotate"></i></button>
          </div>
        </div>
        <p class="tg-life-mood-text">{{lifeTavern.atmosphere.mood.text}}</p>
        {{#if availability}}
          <div class="tg-life-availability">
            <div><span>Нагрузка</span><strong>{{availability.label}}</strong></div>
            <div><span>Конечные запасы</span><strong>{{availability.reservePercent}}% занято гостями</strong></div>
            <div><span>Безлимитные товары</span><strong>{{availability.goodsCapLabel}}</strong></div>
            <div><span>Услуги</span><strong>{{availability.servicesCapLabel}}</strong></div>
          </div>
          <p class="tg-life-availability-note">{{availability.summary}}</p>
        {{/if}}
      </div>

      <div class="tg-life-grid">
        <div class="tg-panel">
          <div class="tg-panel-head"><h3>Слухи</h3></div>
          <div class="tg-life-list">
            {{#each lifeTavern.atmosphere.rumors}}
              <article class="tg-life-entry">
                <div class="tg-life-entry-main">
                  <strong>{{title}}</strong>
                  <p>{{text}}</p>
                  {{#if gmText}}<details><summary>Правда для ГМа</summary><p>{{gmText}}</p></details>{{/if}}
                </div>
                <div class="tg-life-actions">
                  <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} class="{{#if pinned}}is-pinned{{/if}}" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}" data-gm-action="toggleLifePinned" data-section="rumors" data-entry-id="{{id}}" data-tooltip="{{#if pinned}}Открепить слух{{else}}Сохранить слух при смене дня{{/if}}" aria-label="{{#if pinned}}Открепить слух{{else}}Сохранить слух при смене дня{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>
                  <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="rerollLifeEntry" data-section="rumors" data-entry-id="{{id}}" data-tooltip="Заменить слух" aria-label="Заменить слух"><i class="fa-solid fa-dice"></i></button>
                  <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="sendLifeEntry" data-section="rumors" data-entry-id="{{id}}" data-tooltip="Отправить игрокам в чат" aria-label="Отправить игрокам в чат"><i class="fa-solid fa-comment"></i></button>
                </div>
              </article>
            {{/each}}
          </div>
        </div>

        <div class="tg-panel">
          <div class="tg-panel-head"><h3>Завсегдатаи</h3></div>
          <div class="tg-life-list">
            {{#each lifeTavern.atmosphere.regulars}}
              <article class="tg-life-entry">
                <div class="tg-life-entry-main">
                  <strong>{{title}}</strong>
                  <p>{{description}}</p>
                  {{#if goal}}<small><b>Цель:</b> {{goal}}</small>{{/if}}
                  {{#if gmText}}<details><summary>Секрет для ГМа</summary><p>{{gmText}}</p></details>{{/if}}
                </div>
                <div class="tg-life-actions">
                  <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} class="{{#if pinned}}is-pinned{{/if}}" aria-pressed="{{#if pinned}}true{{else}}false{{/if}}" data-gm-action="toggleLifePinned" data-section="regulars" data-entry-id="{{id}}" data-tooltip="{{#if pinned}}Открепить посетителя{{else}}Сделать постоянным посетителем{{/if}}" aria-label="{{#if pinned}}Открепить посетителя{{else}}Сделать постоянным посетителем{{/if}}"><i class="fa-solid fa-thumbtack"></i></button>
                  <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="rerollLifeEntry" data-section="regulars" data-entry-id="{{id}}" data-tooltip="Заменить посетителя" aria-label="Заменить посетителя"><i class="fa-solid fa-dice"></i></button>
                  <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="sendLifeEntry" data-section="regulars" data-entry-id="{{id}}" data-tooltip="Представить игрокам в чате" aria-label="Представить игрокам в чате"><i class="fa-solid fa-comment"></i></button>
                </div>
              </article>
            {{/each}}
          </div>
        </div>
      </div>

      <div class="tg-panel tg-panel-full tg-incident-card">
        <div class="tg-panel-head">
          <div>
            <h3>Происшествие</h3>
            <strong>{{lifeTavern.atmosphere.incident.title}}</strong>
          </div>
          <div class="tg-panel-head-actions">
            <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="rerollIncident" data-section="incident" data-tooltip="Другое происшествие" aria-label="Другое происшествие"><i class="fa-solid fa-dice"></i></button>
            <button type="button" {{#if @root.gmActionPending}}disabled{{/if}} data-gm-action="sendLifeEntry" data-section="incident" data-entry-id="{{lifeTavern.atmosphere.incident.id}}" data-tooltip="Отправить происшествие игрокам в чат" aria-label="Отправить происшествие игрокам в чат"><i class="fa-solid fa-comment"></i></button>
          </div>
        </div>
        <p>{{lifeTavern.atmosphere.incident.text}}</p>
        {{#if lifeTavern.atmosphere.incident.gmText}}<details><summary>Скрытая сторона происшествия</summary><p>{{lifeTavern.atmosphere.incident.gmText}}</p></details>{{/if}}
      </div>
    </section>

        {{else}}
          <section class="tg-empty"><i class="fa-solid fa-user-shield"></i><p>Полные данные этой таверны недоступны. Открой её из сохранений ГМа.</p></section>
        {{/if}}
      </div>
    {{/if}}
  {{else}}
    <section class="tg-empty">
      <i class="fa-solid fa-door-closed"></i>
      <p>Сейчас нет активной таверны. ГМ еще не открыл заведение.</p>
    </section>
  {{/if}}
</section>
